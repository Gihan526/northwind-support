# Copy to .env and adjust if you need something other than the defaults.
#   cp .env.example .env
# .env is git-ignored - never commit real credentials.

# --- Database (used by docker-compose.yml) ---------------------------------
# The SA password for the local SQL Server container.
MSSQL_SA_PASSWORD=Local_Dev_Password1

# --- Backend ---------------------------------------------------------------
# ASP.NET Core reads configuration from environment variables, where "__" means
# "nested section". Setting this overrides ConnectionStrings:Default from
# apps/api/src/SupportDesk.Presentation/appsettings.Development.json - useful if you run SQL Server elsewhere,
# or on another port.
# This is for a host-run API. Compose creates its own connection string with the
# sqlserver service name and MSSQL_SA_PASSWORD; do not pass localhost to the container.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False

# Development turns on Swagger, the automatic migration and the demo seed data.
ASPNETCORE_ENVIRONMENT=Development

# React stays on the host. Use this target when running the API in Compose.
# For the host-run API, leave it unset (defaults to https://localhost:7043).
# VITE_API_PROXY_TARGET=http://localhost:5080

# --- Agent authentication --------------------------------------------------
# These are public LOCAL fixtures. Replace the signing key for any real deployment.
Jwt__SigningKey=Local_Dev_Only_Replace_With_Random_Key_123456789
Jwt__Issuer=NorthwindSupportDesk
Jwt__Audience=NorthwindSupportDeskWeb
Jwt__LifetimeMinutes=60
DevelopmentSeed__AgentPassword=Local_Dev_Login_123!

# --- SLA rules (passed to the API container at runtime) ---------------------
Sla__BaseWindowHours__Low=72
Sla__BaseWindowHours__Medium=24
Sla__BaseWindowHours__High=8
Sla__BaseWindowHours__Critical=4
Sla__PremiumCustomerMultiplier=0.5
Sla__MinimumWindowHours=1
Sla__AtRiskThresholdPercent=25
