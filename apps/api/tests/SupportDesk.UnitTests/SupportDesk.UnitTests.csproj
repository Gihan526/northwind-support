<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests, laid out to mirror src: Domain/ tests the aggregates on their own; Application/
    tests the commands and queries with their repositories mocked. Sqlite is available for
    repository and query tests against a real database.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SupportDesk.Presentation/SupportDesk.Presentation.csproj" />
    <ProjectReference Include="../../src/SupportDesk.Application/SupportDesk.Application.csproj" />
    <ProjectReference Include="../../src/SupportDesk.Domain/SupportDesk.Domain.csproj" />
    <ProjectReference Include="../../src/SupportDesk.Infrastructure/SupportDesk.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
